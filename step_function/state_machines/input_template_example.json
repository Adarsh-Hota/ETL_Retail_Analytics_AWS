{
  "simulation_date": null,
  "low_stock_threshold": 10,
  "run_redshift_refresh": false,
  "resources": {
    "lambda_function_arn": "arn:aws:lambda:<aws-region>:<aws-account-id>:function:<retail-generator-function-name>",
    "glue": {
      "catalog_name": "glue_catalog",
      "silver_database": "retail_silver",
      "jobs": {
        "customers": "customers_bronze_to_silver",
        "products": "products_bronze_to_silver",
        "orders": "orders_bronze_to_silver",
        "payments": "payments_bronze_to_silver",
        "inventory": "inventory_bronze_to_silver",
        "clickstream": "clickstream_bronze_to_silver"
      }
    },
    "emr": {
      "application_id": "<emr-serverless-application-id>",
      "execution_role_arn": "arn:aws:iam::<aws-account-id>:role/<emr-serverless-execution-role>",
      "configuration_overrides": {
        "ApplicationConfiguration": [
          {
            "Classification": "spark-defaults",
            "Configurations": [],
            "Properties": {
              "spark.sql.catalog.glue_catalog.io-impl": "org.apache.iceberg.aws.s3.S3FileIO",
              "spark.sql.extensions": "org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions",
              "spark.sql.catalog.glue_catalog.catalog-impl": "org.apache.iceberg.aws.glue.GlueCatalog",
              "spark.sql.catalog.glue_catalog.warehouse": "s3://<bucket-name>/<iceberg-warehouse-prefix>/",
              "spark.sql.catalog.glue_catalog": "org.apache.iceberg.spark.SparkCatalog",
              "spark.jars": "/usr/share/aws/iceberg/lib/iceberg-spark3-runtime.jar"
            }
          }
        ]
      },
      "scripts": {
        "product_performance": "s3://<bucket-name>/<emr-script-prefix>/gold_product_performance.py",
        "customer_metrics": "s3://<bucket-name>/<emr-script-prefix>/gold_customer_metrics.py",
        "daily_sales": "s3://<bucket-name>/<emr-script-prefix>/gold_daily_sales.py",
        "inventory_health": "s3://<bucket-name>/<emr-script-prefix>/gold_inventory_health.py",
        "customer_lifetime_value": "s3://<bucket-name>/<emr-script-prefix>/gold_customer_lifetime_value.py",
        "clickstream_session_analytics": "s3://<bucket-name>/<emr-script-prefix>/gold_clickstream_session_analytics.py",
        "conversion_funnel": "s3://<bucket-name>/<emr-script-prefix>/gold_conversion_funnel.py"
      }
    },
    "redshift": {
      "workgroup_name": "<redshift-serverless-workgroup-name>",
      "database": "<redshift-database-name>"
    }
  }
}
